*.py[cod]
*.egg-info/
.venv/
.env
.env.*
!.env.example
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/
dist/
build/
models/
reports/
data/**/*
!data/**/
!data/**/.gitkeep
!data/**/README.md
# One attributed, immutable public OSM snapshot enables offline reconstruction.
!data/raw/osm_snapshot/manifest.json
!data/raw/osm_snapshot/pharmacies_morocco_raw.json
# Attributed, compressed original BDPM bytes; derived SQLite stays ignored.
!data/raw/bdpm_snapshot/manifest.json
!data/raw/bdpm_snapshot/download_page.html
!data/raw/bdpm_snapshot/CIS_bdpm.txt.gz
!data/raw/bdpm_snapshot/CIS_COMPO_bdpm.txt.gz
!data/raw/bdpm_snapshot/CIS_CIP_bdpm.txt.gz
tmp/

# Dataset inputs are versioned; generated splits are reproducible build outputs.
!data/nlu/dev_seed.jsonl
!data/nlu/gold_human.jsonl
!data/nlu/medication_roster.json

!data/nlu/generated/train.jsonl
!data/nlu/generated/dev.jsonl
!data/nlu/generated/test.jsonl

# Unverified draft and review proposals; never final gold.
!data/nlu/gold_human_draft.txt
!data/nlu/gold_review.jsonl

# Optional DOM interaction checks
web/node_modules/

# Small attributed educational reference cache; no private health data.
!data/health/references.json

# Attributed public contact enrichment.
!data/pharmacies/contact_enrichment.json
