            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Medication Ref"
        },
        "type": {
          "const": "DOSAGE",
          "title": "Type",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "exclusiveMinimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value"
