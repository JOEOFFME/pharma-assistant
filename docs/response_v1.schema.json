    "ClarificationQuestion": {
      "additionalProperties": false,
      "description": "Questions in supported response languages; absent values are null.",
      "properties": {
        "fr": {
          "anyOf": [
            {
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Fr"
        },
        "ar": {
          "anyOf": [
            {
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ar"
        }
      },
      "title": "ClarificationQuestion",
      "type": "object"
    },
    "DosageEntity": {
      "additionalProperties": false,
