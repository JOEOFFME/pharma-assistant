  "additionalProperties": false,
  "description": "Structured interpretation v1 with cross-field consistency checks.",
  "properties": {
    "request_id": {
      "format": "uuid",
      "title": "Request Id",
      "type": "string"
    },
    "input": {
      "$ref": "#/$defs/InputInfo"
    },
    "intent": {
      "$ref": "#/$defs/Intent"
    },
    "entities": {
      "items": {
        "discriminator": {
          "mapping": {
            "DOSAGE": "#/$defs/DosageEntity",
            "FORM": "#/$defs/FormEntity",
            "LOCATION": "#/$defs/LocationEntity",
            "MEDICATION": "#/$defs/MedicationEntity",
            "PHARMACY_NAME": "#/$defs/PharmacyNameEntity",
            "QUANTITY": "#/$defs/QuantityEntity",
            "TIME_REF": "#/$defs/TimeRefEntity",
            "URGENCY": "#/$defs/UrgencyEntity"
          },
          "propertyName": "type"
        },
        "oneOf": [
          {
            "$ref": "#/$defs/MedicationEntity"
          },
          {
            "$ref": "#/$defs/DosageEntity"
          },
          {
            "$ref": "#/$defs/FormEntity"
          },
          {
            "$ref": "#/$defs/QuantityEntity"
          },
          {
            "$ref": "#/$defs/PharmacyNameEntity"
          },
          {
            "$ref": "#/$defs/LocationEntity"
          },
          {
            "$ref": "#/$defs/TimeRefEntity"
          },
          {
            "$ref": "#/$defs/UrgencyEntity"
          }
        ]
      },
      "title": "Entities",
      "type": "array"
    },
    "pharmacy_query": {
      "$ref": "#/$defs/PharmacyQuery"
    },
    "needs_clarification": {
      "title": "Needs Clarification",
      "type": "boolean"
    },
    "clarification_question": {
      "$ref": "#/$defs/ClarificationQuestion"
    },
    "disclaimer": {
      "const": "Cet assistant ne fournit pas de conseil médical.",
      "default": "Cet assistant ne fournit pas de conseil médical.",
      "title": "Disclaimer",
      "type": "string"
    },
    "latency_ms": {
      "minimum": 0,
      "title": "Latency Ms",
      "type": "integer"
    }
  },
  "required": [
    "request_id",
    "input",
