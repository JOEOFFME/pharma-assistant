  "additionalProperties": false,
  "description": "Versioned annotation record; creation provenance never implies verification.",
  "properties": {
    "id": {
      "pattern": "\\S",
      "title": "Id",
      "type": "string"
    },
    "text": {
      "maxLength": 10000,
      "pattern": "\\S",
      "title": "Text",
      "type": "string"
    },
    "language": {
      "enum": [
        "darija_ar",
        "darija_latn",
        "ar",
        "fr",
        "mixed"
      ],
