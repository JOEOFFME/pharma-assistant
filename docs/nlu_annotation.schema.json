      "type": "string"
    },
    "intent": {
      "enum": [
        "check_availability",
        "request_medication",
        "pharmacy_info_phone",
        "pharmacy_info_location",
        "pharmacy_info_hours",
        "price_inquiry",
        "greeting_smalltalk",
        "out_of_scope"
      ],
      "title": "Intent",
      "type": "string"
    },
    "entities": {
      "items": {
        "discriminator": {
          "mapping": {
            "DOSAGE": "#/$defs/DosageEntity",
            "FORM": "#/$defs/FormEntity",
            "LOCATION": "#/$defs/LocationEntity",
            "MEDICATION": "#/$defs/MedicationEntity",
            "PHARMACY_NAME": "#/$defs/PharmacyNameEntity",
            "QUANTITY": "#/$defs/QuantityEntity",
            "TIME_REF": "#/$defs/TimeRefEntity",
            "URGENCY": "#/$defs/UrgencyEntity"
          },
          "propertyName": "type"
        },
        "oneOf": [
          {
            "$ref": "#/$defs/MedicationEntity"
          },
          {
            "$ref": "#/$defs/DosageEntity"
          },
          {
            "$ref": "#/$defs/FormEntity"
          },
          {
            "$ref": "#/$defs/QuantityEntity"
          },
          {
            "$ref": "#/$defs/PharmacyNameEntity"
          },
          {
            "$ref": "#/$defs/LocationEntity"
          },
          {
            "$ref": "#/$defs/TimeRefEntity"
          },
          {
            "$ref": "#/$defs/UrgencyEntity"
          }
        ]
      },
      "title": "Entities",
      "type": "array"
    },
    "relations": {
      "items": {
        "$ref": "#/$defs/Relation"
      },
      "title": "Relations",
      "type": "array"
    },
    "needs_clarification": {
