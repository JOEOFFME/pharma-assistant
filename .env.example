# Make-compatible settings. Never commit real secrets.
HOST=127.0.0.1
PORT=8000
LOG_LEVEL=info
PYTHONHASHSEED=42

# Optional local API protection and browser origin allowlist.
API_KEY=
CORS_ORIGINS=
RATE_LIMIT_PER_MINUTE=120

# Main conversational model. Copy this file to .env; startup loads it automatically.
# PowerShell environment variables take precedence. Baseline is an explicit offline mode.
ASSISTANT_NLU=openrouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4.1
OPENROUTER_FALLBACK_MODEL=anthropic/claude-sonnet-4.6

# Read-only agent: source catalogue, pharmacy directory and trusted health web research.
# Web research uses the OpenRouter key and incurs additional search charges.
ASSISTANT_AGENT=true
ASSISTANT_WEB_SEARCH=true

# Research is primary; disable only to reproduce the older bounded demo mode.
ASSISTANT_WEB_FIRST=true
