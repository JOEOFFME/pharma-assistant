# Make-compatible settings. Never commit real secrets.
HOST=127.0.0.1
PORT=8000
LOG_LEVEL=info
PYTHONHASHSEED=42

# Optional local API protection and browser origin allowlist.
API_KEY=
CORS_ORIGINS=
RATE_LIMIT_PER_MINUTE=120

# Optional consumer language understanding. Default stays offline/baseline.
# Set these in the server environment; start_service.py does not auto-load .env.
# Use an OpenRouter model ID that supports structured JSON output.
ASSISTANT_NLU=baseline
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
